# Optional public/default overrides for local `npm run dev` or Wrangler.
# API keys are NOT configured here; fill them in the app UI and they stay in this browser only.
# NEVER commit real keys. NEVER paste keys into chat.

# LLM_BASE_URL=https://api.siliconflow.cn/v1
# STT_BASE_URL=https://api.siliconflow.cn/v1
# TTS_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3.5-4B
# STT_MODEL=FunAudioLLM/SenseVoiceSmall
# TTS_MODEL=FnLP/MOSS-TTSD-v0.5
# TTS_VOICE=alloy
# LLM_MAX_TOKENS=512
# LLM_TEMPERATURE=0.7

# Local server listens on 127.0.0.1 by default. Enable LAN access only when needed.
# HOST=0.0.0.0

# Trusted local model endpoints are blocked by default.
# ALLOW_PRIVATE_UPSTREAMS=true

# 只有当你通过内网穿透/隧道/自定义域名访问本地服务时才需要设置。
# 逗号分隔，不含端口。默认只允许 localhost / 内网 IP 访问 /api/*。
# ALLOWED_HOSTS=my-tunnel.example.com,nas.local
